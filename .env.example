# 1) Supabase → Project Settings → Database → Connect → copie as URIs (Transaction vs Direct).
# 2) Senha com caracteres especiais: use a URI já codificada do painel.
#
# Recomendado (Next.js / Prisma em dev e produção): Transaction pooler na porta 6543 para não estourar max_connections.
# O Prisma exige ?pgbouncer=true em modo transação. connection_limit=1 ajuda em serverless/HMR.
#
# DATABASE_URL = pooler transação (6543) — uso geral da aplicação
# DIRECT_URL   = conexão direta (5432) — prisma migrate, db push, introspection
#
# Formato comum (host db.<ref>.supabase.co:6543 — painel "Transaction"):
DATABASE_URL="postgresql://postgres:SENHA@db.<PROJECT_REF>.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15&sslmode=require"
#
# Alternativa regional (pooler compartilhado), se o painel mostrar aws-0-REGION:
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#
# Conexão direta (migrations / db pull). sslmode + connect_timeout + supavisor em hosts db.* ajudam rede restrita:
DIRECT_URL="postgresql://postgres:SENHA@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require&connect_timeout=30&supavisor=true"
# Opcional: tempo extra (ms) para prismaEnsureConnected() em lib/prisma.ts
# PRISMA_CONNECT_WAIT_MS=35000

# ── Lookup externo por código de barras (Cosmos/Bluesoft) — GOAL 004A ──────────
# COSMOS_API_KEY: token da conta Bluesoft Cosmos (somente server-side).
#   NUNCA no client/bundle/logs. Header: X-Cosmos-Token + User-Agent: Cosmos-API-Request.
#   Não commitar token real aqui — deixe vazio.
COSMOS_API_KEY=
# BARCODE_LOOKUP_PROVIDERS: ordem CSV dos provedores de lookup externo.
#   Default quando vazio: cosmos. Valores aceitos: cosmos, upcitemdb, openfoodfacts.
#   (upcitemdb FREE/trial ativo desde GOAL 004B; openfoodfacts futuro GOAL 004C.)
BARCODE_LOOKUP_PROVIDERS=cosmos

# ── Portal legado do Contador (/contador, /login-contador) — GOAL 003 ──────────
# CONTADOR_PIN: PIN temporário do portal legado. Sem PIN default — sem esta env, a
#   autenticação fica indisponível (fail-closed, 503).
CONTADOR_PIN=
# CONTADOR_SESSION_SECRET: segredo forte para assinatura HMAC-SHA256 da sessão do
#   portal legado. Sem esta env, a autenticação também fica indisponível (503).
CONTADOR_SESSION_SECRET=
# CONTADOR_LEGACY_PORTAL: "on" ou "off". Kill-switch do portal legado — "off" desativa
#   /api/auth/contador (503), /contador e mostra página estática em /login-contador.
CONTADOR_LEGACY_PORTAL=on

# ── Documentos do Contador · storage privado — GOAL 010/012C ───────────────────
# Provider de armazenamento dos documentos contábeis (bucket PRIVADO, nunca público).
# Fluxo: upload direto do navegador por URL assinada (presigned PUT — o binário NUNCA
# passa pela API Next.js); upload server-side PutObject para o ZIP oficial do pacote;
# download por URL assinada de curta duração (<= 300s), sempre attachment.
#
# ── Provider oficial: Cloudflare R2 (S3-compatible) — GOAL 012C ──────────────
# Variáveis SERVER-SIDE. NUNCA devem ter prefixo NEXT_PUBLIC. Nenhum valor real aqui.
#
# CONTADOR_STORAGE_PROVIDER: provider produtivo. OBRIGATÓRIA (GOAL 012E · P2) — não
#   há mais default. Ausente ou vazia falha cerrado, igual a um valor inválido: um
#   gate que adivinha o provider quando a variável some não é um gate.
#   Único valor aceito nesta fase: "r2". "supabase" (ou qualquer outro) falha cerrado —
#   não há fallback automático. O adapter Supabase está @deprecated e só serve como
#   caminho de rollback MANUAL (troca de import + provisionamento próprio).
CONTADOR_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID: Account ID Cloudflare (visto no painel → R2 → Overview). Compõe o
#   endpoint S3 `https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com`. Não commitar valor.
#   Validado no formato: só [A-Za-z0-9_-]. Um valor com "." "/" "@" ou ":" deixaria de
#   ser subdomínio e apontaria as credenciais R2 para outro host — por isso é recusado.
R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID: Access Key ID do token R2 bucket-scoped (NÃO account-wide).
#   Criar em Cloudflare → R2 → Manage R2 API Tokens → Create (Permissions: Object Read
#   & Write; Bucket scope: somente o(s) bucket(s) do Contador). NUNCA com NEXT_PUBLIC.
R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY: Secret Access Key do mesmo token R2 (NÃO recuperável depois —
#   guarde em secrets manager). Server-only, NUNCA em logs, NUNCA NEXT_PUBLIC.
R2_SECRET_ACCESS_KEY=
# R2_BUCKET: nome do bucket privado do Contador para ESTE ambiente Vercel.
#   USE BUCKETS SEPARADOS por ambiente:
#     Preview    → ex.: omni-contador-documentos-preview
#     Production → ex.: omni-contador-documentos-prod
#   No GOAL 012C somente o bucket de Preview é usado. Bucket criado com
#   `public_access = OFF` no painel Cloudflare.
R2_BUCKET=omni-contador-documentos-preview
# R2_SIGNED_URL_TTL_SECONDS (OPCIONAL): override do TTL default das signed URLs (em
#   segundos). O adapter sempre capara no teto do contrato: upload <= 120s,
#   download <= 300s. Se omitido, usa esses tetos como default. Útil para
#   encurtar o TTL em diagnósticos.
# R2_SIGNED_URL_TTL_SECONDS=120
#
# CONTADOR_UPLOAD_INTENT_SECRET (OPCIONAL): segredo de assinatura da autorização de
#   upload (GOAL 012E · P1). O `complete` só aceita um `uploadIntent` assinado, que
#   vincula loja, usuário, competência, documentoId, storageRef, nome, MIME, bytes,
#   SHA-256, categoria e expiração — é o que impede o cliente de apontar a confirmação
#   para o blob de outro documento. Se AUSENTE, a chave é derivada de `AUTH_SECRET`
#   (com separação de domínio via HMAC), então NÃO é preciso provisionar nada novo.
#   Defina apenas para rotacionar a assinatura de upload sem mexer no NextAuth.
#   Server-only; NUNCA com prefixo NEXT_PUBLIC. Trocar o valor invalida os intents
#   em voo (janela de 10 min) — os uploads em curso precisam ser refeitos.
# CONTADOR_UPLOAD_INTENT_SECRET=
#
# CONTADOR_EXTERNO_SESSION_SECRET (OBRIGATÓRIO para o portal externo do contador,
#   GOAL 014): segredo DEDICADO do cookie HMAC da sessão externa
#   (`assistec_contador_ext_session`, payload {v,sid,tv,iat,exp}, validade <= 12h,
#   rotativo). A chave de assinatura é derivada deste valor com separação de
#   domínio (HMAC) — não é o segredo do NextAuth e não tem fallback: se AUSENTE,
#   as rotas de auth externa (`/api/contador-externo/**`) respondem 503
#   fail-closed e o portal fica inerte, sem afetar o ERP nem o portal legado.
#   Server-only; NUNCA com prefixo NEXT_PUBLIC; provisionado pelo processo
#   oficial de segredos, NUNCA commitado com valor. Trocar o valor invalida
#   todas as sessões externas em aberto (logout geral dos contadores).
# CONTADOR_EXTERNO_SESSION_SECRET=
#
# CONTADOR_PORTAL_V2 (OPCIONAL, GOAL 015): "on" liga o portal externo READ-ONLY
#   do contador — páginas `/contador-externo/lojas/**` e rotas de dados
#   `/api/contador-externo/lojas/**` (competências, documentos, pacotes, timeline
#   e comentários). DEFAULT OFF: ausente ou com qualquer outro valor, páginas e
#   APIs de dados respondem 404 genérico ANTES de conferir sessão, loja ou
#   recurso — não confirmam nem a própria existência. Só o valor exato "on"
#   (case-insensitive) habilita. Login, aceite de convite e a lista de empresas
#   do GOAL 014 NÃO dependem desta flag e seguem funcionando com ela desligada.
#   Ligar em Production é decisão humana, depois do smoke com a flag OFF.
# CONTADOR_PORTAL_V2=off

# ── Legado: Supabase Storage (DEPRECATED — GOAL 012C) ─────────────────────────
# Mantido APENAS como caminho de rollback MANUAL (ver
# docs/contador/CONTADOR_HUB_STORAGE_PROVIDER_DECISION_012B.md §7.1). Nenhum import
# produtivo consome estas variáveis — o adapter `storage-supabase.ts` está
# `@deprecated`. Reativação recriaria o risco que motivou o congelamento do Supabase
# (`service_role` project-wide que bypassa RLS, sem isolamento nativo Preview×Prod).
#
# SUPABASE_URL: URL do projeto Supabase (ex.: https://<PROJECT_REF>.supabase.co).
#   Server-side. Não commitar valor real aqui.
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY: chave service_role do Supabase. EXCLUSIVAMENTE server-side —
#   NUNCA com prefixo NEXT_PUBLIC, NUNCA enviada ao navegador, NUNCA em logs. Bypassa RLS;
#   usada apenas pelo adapter server-side de Storage. Não commitar valor real aqui.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET: nome do bucket privado dos documentos do Contador.
SUPABASE_STORAGE_BUCKET=contador-documentos
